# ShotMill local backend storage.
SHOTMILL_DATA_ROOT=.shotmill
SHOTMILL_AUTO_MIGRATE=true
SHOTMILL_GENERATION_WORKERS=1

# Optional multimodal Prompt AI provider (OpenAI-compatible endpoint).
SHOTMILL_PROMPT_AI_BASE_URL=
SHOTMILL_PROMPT_AI_API_KEY=
SHOTMILL_PROMPT_AI_MODEL=
SHOTMILL_PROMPT_AI_SUPPORTS_VIDEO=false

# Optional Video Generation Provider: ComfyUI.
SHOTMILL_COMFYUI_ROOT=G:\AIGC\ComfyUI_Codex
SHOTMILL_COMFYUI_BASE_URL=http://127.0.0.1:8188
# Backward-compatible alias also accepted: SHOTMILL_COMFYUI_ENDPOINT
SHOTMILL_COMFYUI_WORKFLOW_TEMPLATE=backend/shotmill/providers/video_generation/workflows/minimax_h3_reference_api.json
SHOTMILL_PROVIDER_POLL_INTERVAL=1.0
SHOTMILL_PROVIDER_TIMEOUT=600
